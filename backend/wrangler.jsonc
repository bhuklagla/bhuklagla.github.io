{
  "name": "bhuk-lagla-journeys",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "triggers": { "crons": ["0 0 * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "https://your-approved-domain.example",
    "NTFY_SERVER": "https://ntfy.sh",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bhuk-lagla-journeys",
      "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
}
