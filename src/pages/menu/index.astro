---
import Layout from '../../layouts/Layout.astro';
import MenuBrowser from '../../components/MenuBrowser.astro';
import OrderButton from '../../components/OrderButton.astro';
import { menuSchema } from '../../lib/seo';
import { url } from '../../lib/site';
const schema = menuSchema();
---

<Layout
  title="Menu | Pizza, Sandwiches, Maggi & Snacks — Bhuk Lagla"
  description="Browse 23 pure-veg dishes from Bhuk Lagla in Sundargarh. Explore air-fryer pizza, grilled sandwiches, fries, Maggi and pasta, then order on Zomato."
  active="menu"
  schema={schema}
>
  <section class="wrap page-heading">
    <p class="eyebrow">Find your hunger fix</p>
    <h1>What are you craving?</h1>
    <p>Pure veg. No egg. Pick a dish, then head to Zomato.</p>
    <p class="small-text">
      Food images are AI-generated menu illustrations. Actual presentation may vary.
    </p>
    <div class="category-links">
      <a class="button secondary" href={url('choose/')}>
        Compare toppings and fillings →
      </a>
      <a class="text-link" href={url('answers/')}>
        Food and ordering questions →
      </a>
    </div>
  </section>
  <section class="wrap menu-section">
    <MenuBrowser />
  </section>
  <section class="wrap note-panel">
    <div>
      <h2>Ready to order?</h2>
      <p>Zomato shows current availability, delivery options and offers eligible for you.</p>
    </div>
    <OrderButton />
  </section>
</Layout>
