---
import { url } from '../lib/site';
const {
  id,
  alt = '',
  eager = false,
  class: className = '',
  sizes = '(max-width: 600px) 90vw, 33vw',
} = Astro.props;
---

<img
  class={className}
  src={url(`images/menu/${id}-640.webp`)}
  srcset={`${url(`images/menu/${id}-320.webp`)} 320w, ${url(`images/menu/${id}-640.webp`)} 640w, ${url(`images/menu/${id}-960.webp`)} 960w`}
  sizes={sizes}
  width="960"
  height="640"
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
/>
